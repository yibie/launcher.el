;;; launcher-clipboard-tests.el --- Tests for clipboard and characters -*- lexical-binding: t; -*-

(require 'cl-lib)
(require 'ert)
(require 'launcher)
(require 'launcher-clipboard)
(require 'launcher-characters)

(ert-deftest launcher-clipboard-lists-distinct-entries ()
  (let ((kill-ring (list "new" "  " "line one\nline two" "new"))
        (interprogram-paste-function #'ignore)
        (launcher-tools (list (launcher-clipboard-tool "c"))))
    (should (launcher--tools))
    (let ((candidates (launcher-clipboard--candidates)))
      (should (equal '("new" "line one ⏎ line two")
                     (mapcar (lambda (c) (plist-get c :title)) candidates)))
      (should (equal "2 lines, 17 chars" (plist-get (nth 1 candidates) :subtitle)))
      (should (equal "line one\nline two" (plist-get (nth 1 candidates) :data))))))

(ert-deftest launcher-clipboard-includes-system-clipboard ()
  (let ((kill-ring (list "old")) (kill-ring-yank-pointer nil)
        (interprogram-paste-function (lambda () "from another app")))
    (should (equal "from another app"
                   (plist-get (car (launcher-clipboard--candidates)) :data)))))

(ert-deftest launcher-clipboard-title-is-truncated ()
  (let ((launcher-clipboard-title-width 10))
    (should (<= (string-width (launcher-clipboard--title (make-string 50 ?x))) 10))))

(ert-deftest launcher-clipboard-submit-moves-entry-to-front ()
  (let* ((kill-ring (list "a" "b" "c")) (hooked nil)
         (interprogram-cut-function nil) (interprogram-paste-function #'ignore)
         (launcher-after-copy-hook (list (lambda () (setq hooked t))))
         (action (launcher-clipboard--submit (list :data "c"))))
    (should (functionp action))
    (should-not hooked)
    (should-not (funcall action))
    (should (equal '("c" "a" "b") kill-ring))
    (should hooked)))

;;; Embark actions

(ert-deftest launcher-clipboard-delete-removes-entry ()
  (let ((kill-ring (list "a" "b" "a" "c")) (kill-ring-yank-pointer nil))
    (launcher-clipboard-delete "a")
    (should (equal '("b" "c") kill-ring))
    (should (eq kill-ring kill-ring-yank-pointer))))

(ert-deftest launcher-clipboard-join-keeps-order ()
  (let* ((kill-ring (list "x")) (hooked nil) (interprogram-cut-function nil)
         (launcher-after-copy-hook (list (lambda () (setq hooked t))))
         (launcher-clipboard-join-separator ", "))
    (launcher-clipboard-join '("first" "second" "third"))
    (should (equal "first, second, third" (car kill-ring)))
    (should hooked)
    (launcher-clipboard-join "alone")
    (should (equal "alone" (car kill-ring)))))

(ert-deftest launcher-clipboard-edit-replaces-entry ()
  (let ((kill-ring (list "a" "old text" "b")) (interprogram-cut-function nil)
        (launcher-after-copy-hook nil))
    (cl-letf (((symbol-function 'launcher-editing-frame) #'selected-frame))
      (launcher-clipboard-edit "old text")
      (should launcher-clipboard-edit-mode)
      (should (equal "old text" (buffer-string)))
      (goto-char (point-max))
      (insert ", edited")
      (launcher-clipboard-edit-finish))
    (should (equal '("old text, edited" "a" "b") kill-ring))
    (should-not (get-buffer "*launcher-clipboard edit*"))))

(ert-deftest launcher-clipboard-edit-abort-keeps-kill-ring ()
  (let ((kill-ring (list "a" "b")))
    (cl-letf (((symbol-function 'launcher-editing-frame) #'selected-frame))
      (launcher-clipboard-edit "b")
      (erase-buffer)
      (launcher-clipboard-edit-abort))
    (should (equal '("a" "b") kill-ring))))

(ert-deftest launcher-embark-transform-maps-registered-tools ()
  (let* ((clip (launcher-clipboard-tool "c"))
         (launcher-tools (list clip))
         (tool (car (launcher--tools)))
         (other (launcher--tool-make :prefix "o" :submit #'ignore))
         (candidates (make-hash-table :test #'equal)))
    (puthash "k1" (list :tool tool :item (list :data "hello")) candidates)
    (puthash "k2" (list :tool other :item (list :data "x")) candidates)
    (cl-letf (((symbol-function 'launcher--result-for-candidate)
               (lambda (c) (gethash c candidates))))
      (should (equal '(launcher-clipboard . "hello")
                     (launcher-embark-transform 'launcher-result "k1")))
      (should (equal '(launcher-result . "k2")
                     (launcher-embark-transform 'launcher-result "k2")))
      (should (equal '(launcher-result . "none")
                     (launcher-embark-transform 'launcher-result "none"))))))

(ert-deftest launcher-clipboard-embark-setup ()
  (skip-unless (require 'embark nil t))
  (should (eq #'launcher-embark-transform
              (alist-get 'launcher-result embark-transformer-alist)))
  (should (equal '(launcher-clipboard-embark-map)
                 (alist-get 'launcher-clipboard embark-keymap-alist)))
  (should (memq #'launcher-clipboard-join embark-multitarget-actions))
  (should (eq #'embark-select (keymap-lookup launcher-clipboard-embark-map "SPC")))
  (should (eq #'launcher-clipboard-edit (keymap-lookup launcher-clipboard-embark-map "e"))))

(ert-deftest launcher-characters-finds-emoji-first ()
  (let ((launcher-tools (list (launcher-characters-tool "e")))
        (results (launcher-characters--query "grinning face")))
    (should (launcher--tools))
    (should (equal "😀" (plist-get (car results) :data)))
    (should (string-suffix-p "U+1F600" (plist-get (car results) :subtitle)))
    (should (string-suffix-p "grinning face" (plist-get (car results) :title) t))
    (should (eq 'launcher-characters-emoji
                (get-text-property 0 'face (plist-get (car results) :title))))
    (should-not (launcher-characters--query "   "))
    (should-not (launcher-characters--query "zzzz qqqq"))))

(ert-deftest launcher-characters-emoji-are-fully-qualified ()
  (skip-unless (launcher-characters--emoji))
  (let* ((results (launcher-characters--query "red heart"))
         (data (mapcar (lambda (c) (plist-get c :data)) results)))
    (should (equal "❤️" (car data)))
    (should (string-suffix-p "U+2764 U+FE0F" (plist-get (car results) :subtitle)))
    ;; The bare symbol is not offered a second time.
    (should-not (member "❤" (mapcar (lambda (c) (plist-get c :data))
                                    (launcher-characters--query "heavy black heart"))))))

(ert-deftest launcher-characters-emoji-match-other-languages ()
  (skip-unless (and (launcher-characters--emoji)
                    (member "zh_CN" launcher-characters-emoji-languages)))
  (let ((results (launcher-characters--query "红色的心")))
    (should (equal "❤️" (plist-get (car results) :data)))
    (should (string-prefix-p "红色的心" (plist-get (car results) :subtitle))))
  ;; One non-ASCII character is a query; one ASCII letter is not.
  (should (launcher-characters--query "心"))
  (should-not (launcher-characters--query "h"))
  ;; Families and flags come with the system data.
  (should (member "🇯🇵" (mapcar (lambda (c) (plist-get c :data))
                                (launcher-characters--query "flag japan")))))

(ert-deftest launcher-characters-without-emoji-data-uses-ucs-names ()
  (let ((launcher-characters--emoji nil)
        (launcher-characters-emoji-directory "/nonexistent"))
    (should-not (launcher-characters--emoji))
    (should (equal "😀" (plist-get (car (launcher-characters--query "grinning face")) :data)))))

(ert-deftest launcher-characters-symbols-and-limit ()
  (let ((arrow (seq-find (lambda (c) (equal "→" (plist-get c :data)))
                         (launcher-characters--query "rightwards arrow"))))
    (should arrow)
    (should-not (get-text-property 0 'face (plist-get arrow :title))))
  (let ((launcher-characters-limit 5))
    (should (= 5 (length (launcher-characters--query "arrow"))))))

(ert-deftest launcher-characters-submit-copies-and-runs-hook ()
  (let* ((kill-ring nil) (hooked nil) (interprogram-cut-function nil)
         (launcher-after-copy-hook (list (lambda () (setq hooked t)))))
    (funcall (launcher-characters--submit (list :data "★")))
    (should (equal "★" (car kill-ring)))
    (should hooked)))

;;; launcher-clipboard-tests.el ends here
